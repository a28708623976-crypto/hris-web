{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "peopleos-local",
  "send_metrics": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "vars": { "ENV": "production" },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peopleos-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "peopleos-attachments-local",
      "remote": false,
    },
  ],
  "send_email": [{ "name": "EMAIL", "remote": false }],
}
